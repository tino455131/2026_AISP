# 複製成專案根目錄的 .env，再填入各元件的設定。
TEXT_BOT_TOKEN=
VOICE_BOT_TOKEN=
DISCORD_GUILD_ID=

# 語音錄音。LEADER_ROLE_ID 留空時，具備「管理伺服器」權限者可開始／停止錄音。
LEADER_ROLE_ID=
# RECORDINGS_DIR=voice_bot/recordings
# SILENCE_MS=800
# KEEP_AUDIO=0

# 路徑可填絕對路徑，或使用相對於專案根目錄的路徑。
# BOT_DB=data/messages.sqlite3
# STT_PYTHON=voice_bot/voice_stt/.venv/Scripts/python.exe
# READER_PYTHON=text_bot/.venv/Scripts/python.exe
# macOS 虛擬環境的 Python 位於 .venv/bin/python，留空即可使用各平台預設值。

MEETING_SUMMARIZER=simple
# MEETING_SUMMARY_MODEL=gpt-6-luna
OPENAI_API_KEY=
