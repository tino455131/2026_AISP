# 複製成專案根目錄的 .env，再填入各元件的設定。
# 合併版（node team_bot/start.mjs）只用 VOICE_BOT_TOKEN：語音、指令、文字記錄都是這個 bot 帳號。
# TEXT_BOT_TOKEN 只有單獨跑 text_bot/bot.py 時才用（不要和合併版同時跑，訊息會記兩次）。
TEXT_BOT_TOKEN=
VOICE_BOT_TOKEN=
DISCORD_GUILD_ID=

# 語音錄音。LEADER_ROLE_ID 留空時，具備「管理伺服器」權限者可開始／停止錄音。
LEADER_ROLE_ID=
# RECORDINGS_DIR=voice_bot/recordings
# SILENCE_MS=800
# KEEP_AUDIO=0

# 錄音同意方式：direct（預設，頻道裡的人都會錄，可以按「不要錄我」）或 ask（只錄按了同意的人）
# CONSENT_MODE=direct
# 自動錄音：有人進語音頻道就開始錄。預設開啟，填 0 關掉。
# AUTO_RECORD=1
# 只在這些語音頻道自動錄音（頻道 ID，用逗號分開）；留空 = 所有語音頻道
# AUTO_RECORD_CHANNELS=

# 路徑可填絕對路徑，或使用相對於專案根目錄的路徑。
# BOT_DB=data/messages.sqlite3
# STT_PYTHON=voice_bot/voice_stt/.venv/Scripts/python.exe
# READER_PYTHON=text_bot/.venv/Scripts/python.exe
# macOS 虛擬環境的 Python 位於 .venv/bin/python，留空即可使用各平台預設值。

# 摘要器：simple（關鍵字，免費）、openai（OpenAI API，每次都花錢）、
# claude-code（這台電腦已登入的 Claude Code，算訂閱額度，測試用）、模組路徑:類別名稱（其他來源）
MEETING_SUMMARIZER=simple
# MEETING_SUMMARY_MODEL=gpt-6-luna
# 錄音通知裡寫「逐字稿會交給誰整理」；內建的摘要器會自動填，其他來源請寫服務名稱，本機模型填 none
# MEETING_SUMMARY_SENDS_TO=

# 語音辨識：local（預設，本機 Breeze，要 GPU，錄音不離開這台電腦）、openai（OpenAI API，錄音會傳出去、要花錢）
# STT_ENGINE=local
# STT_OPENAI_MODEL=whisper-1
# STT_SENDS_TO=

# 【測試】/ai 用哪個 AI：claude-code、openai 或 模組路徑:類別名稱；留空 = 跟著摘要器（simple 時用 claude-code）
# AI_DEMO_ENGINE=

# 用 openai 摘要或語音辨識時才需要。這是密碼，只能放在 .env。
OPENAI_API_KEY=
