# 語音錄音 bot 的設定。複製成 .env 再填（.env 不會被 commit）。

# 「語音錄音 bot」自己的 token：在 Discord Developer Portal 另外建一個應用程式，
# 不要用皓元那個文字 bot 的 token（同一個 token 不能同時被兩個程式登入）。
DISCORD_TOKEN=your-voice-bot-token-here

# 要服務的伺服器 ID（開發者模式 → 右鍵伺服器 → 複製伺服器 ID）
DISCORD_GUILD_ID=your-server-id-here

# 可以用 /record start、/record stop 的身分組 ID（組長）。
# 留空 = 只有具備「管理伺服器」權限的人可以用。
LEADER_ROLE_ID=

# 錄音同意方式：
#   direct（預設）：語音頻道裡的人都會被錄，不想被錄可以按「不要錄我」，會刪掉他這次已錄的部分
#   ask：只錄按了「同意錄音」的人
# CONSENT_MODE=direct

# 自動錄音：bot 在線上時，有人進入語音頻道就自動開始錄音。
# 預設開啟；填 0 關掉，改回用 /record start 手動開始。
# AUTO_RECORD=1
# 只在這些語音頻道自動錄音（頻道 ID，多個用逗號分開）；留空 = 所有語音頻道
# AUTO_RECORD_CHANNELS=

# 以下通常不用改（路徑相對於 repo 根目錄）
# STT_PYTHON=voice_stt/.venv/Scripts/python.exe
# 「查看摘要／逐字稿」按鈕用的 Python（需要 discord.py）
# READER_PYTHON=discord_bot/.venv/Scripts/python.exe
# BOT_DB=discord_bot/data/messages.sqlite3
# RECORDINGS_DIR=voice_bot/recordings
# 安靜多久（毫秒）算一句話結束
# SILENCE_MS=800

# 測試用：設成 1 時，轉完文字不刪錄音（只保留有被錄的人），方便聽錄音找問題。
# 測完請改回 0，並刪掉 voice_bot/recordings 裡的檔案。
# KEEP_AUDIO=0

# 摘要器：
#   simple：關鍵字，免費，預設
#   claude：Claude API，每次呼叫都會花錢，要填下面的 ANTHROPIC_API_KEY
#   openai：ChatGPT（OpenAI）API，每次呼叫都會花錢，要填下面的 OPENAI_API_KEY，並在 voice_stt/.venv 執行 pip install openai
#   claude-code：用這台電腦已登入的 Claude Code，算在該帳號的訂閱額度；測試用
#   模組路徑:類別名稱：其他來源（別的模型、AI 組自己的做法），寫法見 meeting_ai/README.md
# MEETING_SUMMARIZER=simple
# 只有用 claude 摘要器才需要。這也是密碼，只能放在 .env。
# ANTHROPIC_API_KEY=
# Claude API 用哪個模型（預設 claude-opus-5-5）
# MEETING_SUMMARY_MODEL=
# 錄音通知裡寫「逐字稿會交給誰整理」。simple / claude / claude-code 會自動填；
# 其他來源請寫上服務名稱（例如 OpenAI 的 GPT），在這台電腦上跑的模型填 none
# MEETING_SUMMARY_SENDS_TO=
# ChatGPT API 用哪個模型（預設 gpt-4.1-mini，名稱以 OpenAI 官網為準）
# MEETING_SUMMARY_OPENAI_MODEL=

# 語音辨識（STT）：
#   local（預設）：本機的 Breeze-ASR-25，需要 GPU，錄音不會離開這台電腦
#   openai：OpenAI 的語音轉文字 API，錄音會傳到 OpenAI、每次都會花錢；沒有 GPU 的電腦可以用
#   模組路徑:類別名稱：其他來源，寫法見 voice_stt/README.md
# STT_ENGINE=local
# OpenAI 語音轉文字的模型（預設 whisper-1）
# STT_OPENAI_MODEL=
# 錄音通知裡寫「錄音會交給誰轉文字」；local / openai 會自動填，其他來源請寫上服務名稱
# STT_SENDS_TO=

# 用 openai 摘要或語音辨識時才需要。這也是密碼，只能放在 .env。
# OPENAI_API_KEY=
