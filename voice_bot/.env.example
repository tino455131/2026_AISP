# 語音錄音 bot 的設定。複製成 .env 再填（.env 不會被 commit）。

# 「語音錄音 bot」自己的 token：在 Discord Developer Portal 另外建一個應用程式，
# 不要用皓元那個文字 bot 的 token（同一個 token 不能同時被兩個程式登入）。
DISCORD_TOKEN=your-voice-bot-token-here

# 要服務的伺服器 ID（開發者模式 → 右鍵伺服器 → 複製伺服器 ID）
DISCORD_GUILD_ID=your-server-id-here

# 可以用 /record start、/record stop 的身分組 ID（組長）。
# 留空 = 只有具備「管理伺服器」權限的人可以用。
LEADER_ROLE_ID=

# 以下通常不用改（路徑相對於 repo 根目錄）
# STT_PYTHON=voice_stt/.venv/Scripts/python.exe
# 「查看摘要／逐字稿」按鈕用的 Python（需要 discord.py）
# READER_PYTHON=discord_bot/.venv/Scripts/python.exe
# BOT_DB=discord_bot/data/messages.sqlite3
# RECORDINGS_DIR=voice_bot/recordings
# 安靜多久（毫秒）算一句話結束
# SILENCE_MS=800

# 測試用：設成 1 時，轉完文字不刪錄音（只保留有同意的人），方便聽錄音找問題。
# 測完請改回 0，並刪掉 voice_bot/recordings 裡的檔案。
# KEEP_AUDIO=0

# 摘要器：simple（關鍵字，免費，預設）或 claude（每次呼叫都會花錢）
# MEETING_SUMMARIZER=simple
# 只有用 claude 摘要器才需要。這也是密碼，只能放在 .env。
# ANTHROPIC_API_KEY=
